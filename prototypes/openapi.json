{
  "openapi": "3.1.0",
  "info": {
    "title": "ZeDone synthetic prototype",
    "description": "",
    "license": {
      "name": "CC-BY-NC-SA-4.0",
      "identifier": "CC-BY-NC-SA-4.0"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/prototype/echo": {
      "post": {
        "tags": [],
        "summary": "Return synthetic text unchanged, without storing it.",
        "operationId": "echo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Text returned unchanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/prototype/storage": {
      "post": {
        "tags": [
          "storage"
        ],
        "summary": "Contract marker: HTTP and Android IPC call Storage::execute asynchronously.",
        "operationId": "storage",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StorageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Committed synthetic result or consistent read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageResponse"
                }
              }
            }
          },
          "503": {
            "description": "Storage failed; success not confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "required": [
          "id",
          "column",
          "title",
          "text"
        ],
        "properties": {
          "column": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "EchoRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "EchoResponse": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "space",
          "columns",
          "cards"
        ],
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "space": {
            "$ref": "#/components/schemas/Space"
          }
        },
        "additionalProperties": false
      },
      "Space": {
        "type": "string",
        "enum": [
          "A",
          "B"
        ]
      },
      "StorageError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "StorageRequest": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "space",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "seed"
                ]
              },
              "space": {
                "$ref": "#/components/schemas/Space"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "space",
              "query",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read"
                ]
              },
              "query": {
                "type": "string"
              },
              "space": {
                "$ref": "#/components/schemas/Space"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "space",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "snapshot"
                ]
              },
              "space": {
                "$ref": "#/components/schemas/Space"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "snapshot",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "restore"
                ]
              },
              "snapshot": {
                "$ref": "#/components/schemas/Snapshot"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "space",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "delete"
                ]
              },
              "space": {
                "$ref": "#/components/schemas/Space"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "expected",
              "card",
              "column",
              "position",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "move_card"
                ]
              },
              "card": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "expected": {
                "$ref": "#/components/schemas/Snapshot"
              },
              "position": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "expected",
              "column",
              "position",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "move_column"
                ]
              },
              "column": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "expected": {
                "$ref": "#/components/schemas/Snapshot"
              },
              "position": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              }
            }
          }
        ]
      },
      "StorageResponse": {
        "type": "object",
        "properties": {
          "snapshot": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Snapshot"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
