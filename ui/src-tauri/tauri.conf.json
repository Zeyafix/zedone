{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeDone",
  "version": "0.0.1",
  "identifier": "app.zedone.local",
  "build": {
    "beforeBuildCommand": "bun --bun vite build --config vite.config.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ZeDone", "label": "main" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' http: https:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [{
        "identifier": "markdown-http-links",
        "windows": ["main"],
        "permissions": [{
          "identifier": "opener:allow-open-url",
          "allow": [{ "url": "http://*" }, { "url": "https://*" }]
        }]
      }]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["gen/android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png"],
    "android": { "minSdkVersion": 24 }
  }
}
